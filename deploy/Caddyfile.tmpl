# Hayat — Caddy config (automatic HTTPS via Let's Encrypt). Generated by install.sh.
{
	email __EMAIL__
	# No access logs: client IPs are not recorded (docs/privacy.md).
}

__DOMAIN__ {
	encode zstd gzip
	header -Server
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
