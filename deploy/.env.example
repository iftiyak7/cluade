# Copy to .env and fill in:  cp .env.example .env && nano .env
# Never commit .env.

# Your domain (DNS A/AAAA records must point to this server) and an email for Let's Encrypt notices.
DOMAIN=hayat.example.com
ACME_EMAIL=you@example.com

# Generate both with:  openssl rand -base64 36
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters

# open = anyone with the app can create an account; closed = only access keys created in /admin/users
SIGNUP=open

# Time zone for the admin panel's schedule fields
ADMIN_TZ=Asia/Dhaka

# Browser origins allowed to call the API (not needed for the Android app). Comma-separated.
CORS_ORIGINS=
