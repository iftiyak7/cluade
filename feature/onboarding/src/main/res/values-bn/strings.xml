    <string name="ob_welcome_title">হায়াতে স্বাগতম</string>
    <string name="ob_welcome_text">আপনার দিন পরিকল্পনা করুন, রুটিন মেনে চলুন এবং গুরুত্বপূর্ণ বিষয় মনে রাখুন — সবকিছু এই ফোনেই, ইন্টারনেট বা অ্যাকাউন্ট ছাড়া।</string>
