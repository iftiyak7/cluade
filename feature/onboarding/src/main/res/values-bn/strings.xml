    <string name="ob_day_title">আপনার দিন</string>
    <string name="ob_day_text">হায়াত পানি ও ঘুমের রিমাইন্ডারের জন্য এই সময়গুলো ব্যবহার করে। যেকোনো সময় বদলাতে পারবেন।</string>
