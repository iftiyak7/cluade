    <string name="ob_notifications_title">নোটিফিকেশন</string>
    <string name="ob_notifications_text">রিমাইন্ডার নোটিফিকেশন হিসেবে দেখানো হয়। অ্যান্ড্রয়েড অনুমতি চাইবে। অনুমতি না দিলেও হায়াত রিমাইন্ডার লিখে রাখবে এবং পরে অনুমতি দিতে পারবেন।</string>
