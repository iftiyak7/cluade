    <string name="rel_title">Reminder reliability</string>
    <string name="rel_explain">Hayat schedules reminders on this device without internet. Android may delay or block them if any of the items below are off. Hayat cannot guarantee delivery when the app is force-stopped or restricted by the phone\'s battery manager.</string>
    <string name="rel_notifications">Notifications</string>
    <string name="rel_notifications_off">Off — reminders are recorded but not shown</string>
    <string name="rel_exact">Exact timing (Alarms &amp; reminders)</string>
    <string name="rel_exact_off">Not allowed — reminders may arrive a few minutes late</string>
    <string name="rel_full_screen">Full-screen alarms</string>
    <string name="rel_full_screen_off">Not allowed — alarms appear as a heads-up notification</string>
    <string name="rel_battery">Battery optimisation</string>
    <string name="rel_battery_on">Restricted — some phones delay reminders. Allow Hayat to run unrestricted.</string>
    <string name="rel_ok">Allowed</string>
    <string name="rel_fix">Fix</string>
    <string name="rel_force_stop_note">If you use \"Force stop\", Android cancels all alarms until you open Hayat again. Missed reminders are then marked as missed.</string>
