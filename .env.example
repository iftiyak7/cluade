# Copy to .env (never commit .env). Secrets belong in a secret manager or
# docker secrets files under ./secrets/, NOT in this file, in production.

# ---- safety gates (both must be changed, plus an MFA-authorised admin action, to trade live)
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# ---- database / cache (internal network only)
POSTGRES_DB=pumpfun
POSTGRES_USER=pumpfun
POSTGRES_PASSWORD=change-me-long-random
# used by pf-trader (persistence + restart recovery); internal network only
DATABASE_URL=host=postgres port=5432 user=pumpfun password=change-me-long-random dbname=pumpfun
REDIS_PASSWORD=change-me-long-random

# ---- Solana (operator must supply; paid dedicated RPC recommended)
RPC_PRIMARY_HTTP=
RPC_PRIMARY_WS=
RPC_SECONDARY_HTTP=
RPC_SECONDARY_WS=
GEYSER_GRPC_URL=
# client-side request pacing shared by all RPC endpoints (they usually share a plan)
RPC_MAX_RPS=5
# GEYSER_X_TOKEN -> secrets/geyser_token

# ---- wallet signer: path to the ENCRYPTED keypair; passphrase via secrets/signer_passphrase
SIGNER_KEYSTORE_PATH=/run/secrets/trading_keystore
SIGNER_MAX_LAMPORTS_PER_TX=50000000
SIGNER_MAX_LAMPORTS_PER_DAY=500000000

# ---- telegram (outbound notifications)
TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_TOKEN -> secrets/telegram_bot_token

# ---- admin
ADMIN_PUBLIC_HOST=admin.example.com
ADMIN_IP_ALLOWLIST=
SESSION_TTL_MINUTES=30
